create database bank_database;
use bank_database;
CREATE TABLE Branch (
    branch_name VARCHAR(100) PRIMARY KEY,
    branch_city VARCHAR(100) NOT NULL,
    assets DECIMAL(16,2) NOT NULL
);
CREATE TABLE Customer (
    customer_name VARCHAR(120) PRIMARY KEY,
    customer_street VARCHAR(160) NOT NULL,
    customer_city VARCHAR(80) NOT NULL
);
CREATE TABLE Account (
    account_number INT PRIMARY KEY,
    branch_name VARCHAR(80) NOT NULL,
    balance DECIMAL(14,2) NOT NULL,
    FOREIGN KEY (branch_name)
        REFERENCES Branch(branch_name) ON UPDATE CASCADE ON DELETE RESTRICT
);
CREATE TABLE Depositor (
    customer_name VARCHAR(120) NOT NULL,
    account_number INT NOT NULL,
    PRIMARY KEY (customer_name, account_number),
     FOREIGN KEY (customer_name)
        REFERENCES Customer(customer_name) ON UPDATE CASCADE ON DELETE RESTRICT,
     FOREIGN KEY (account_number)
        REFERENCES Account(account_number) ON UPDATE CASCADE ON DELETE RESTRICT
);
CREATE TABLE Loan (
loan_number INT(50) PRIMARY KEY,
    loan_amount DECIMAL(5,2) NOT NULL,
    branch_name VARCHAR(100) NOT NULL,
    FOREIGN KEY(branch_name) REFERENCES Branch(branch_name) ON UPDATE CASCADE ON DELETE RESTRICT);
